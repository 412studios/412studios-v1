// The studio's existing database, shared with the previous site (412studios-v1).
// Field names and conventions are kept exactly as they are in production so both
// sites can run against the same data during the switch. See lib/legacy.ts for
// the conventions (room ids, YYYYMMDD dates, slot ids) and the old repo's
// FUNCTIONAL_SPEC.md for the full behaviour.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String        @id @unique // Kinde user id, or "guest_…" for pay-now visitors
  name                String?
  email               String        @unique
  role                String        @default("user")
  stripeCustomerId    String?       @unique
  verifyFormSubmitted Boolean       @default(false)
  isUserVerified      Boolean       @default(true)
  userBio             String?
  acceptedTerms       Boolean       @default(false)
  memberships         Memberships[]
  phone               String?
  socialLinks         String?
  categories          String?
  Bookings            Bookings[]
  Pricing             Pricing[]
}

model Bookings {
  bookingId       String     @id
  roomId          Int // 0/1/2 = Studio A/B/C
  date            Int // YYYYMMDD
  type            String     @default("hour") // "hour" = paid; "membership" = drawn from prepaid hours
  startTime       Int // inclusive slot id 0–15, hour = slot + 8
  endTime         Int // inclusive slot id
  status          String     @default("pending") // pending → success | cancelled
  userId          String
  stripeProductId String
  totalHours      Int
  totalPrice      Float // pre-tax CAD
  engineerTotal   Int // engineer hours, -1 = none
  engineerStart   Int // slot id, -1 = none
  engineerStatus  String
  addDetails      String // Google Calendar event id, "" if none
  offerCodeId     String?
  discountAmount  Float?     @default(0)
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id])
  offerCode       OfferCode? @relation(fields: [offerCodeId], references: [id])
}

model Memberships {
  membershipId       String   @id @unique
  stripeSessionId    String
  stripeMembershipId String
  interval           String
  status             String // pending → active | cancelled
  planId             String
  currentPeriodStart Int // YYYYMMDD
  currentPeriodEnd   Int // YYYYMMDD
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @map("updtedAt")
  roomId             Int
  availableHours     Int
  updateHours        DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  weekMax            Boolean  @default(true)
}

model Pricing {
  id               String  @id @unique
  room             String
  dayRate          Int
  hourlyRate       Int
  img              String
  membershipPrice  Int
  membershipPrice8 Int     @default(0)
  engineerPrice    Int
  blocked          Boolean @default(false)
  User             User?   @relation(fields: [userId], references: [id])
  userId           String?
}

model OfferCode {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  discountType  String // "percentage" or "fixed"
  discountValue Float
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bookings      Bookings[]
}
