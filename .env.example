# Copy to .env.local. Use TEST keys (sk_test_...) until the owner confirms the live account.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Member logins (Kinde). Locally: make a free Kinde account, add a "Back-end web" application, and in its
# settings allow callback http://localhost:3000/api/auth/kinde_callback and logout http://localhost:3000.
# Production uses the studio's existing Kinde tenant instead, so current members keep their logins.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/account
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
