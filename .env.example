# Copy to .env.local. Use TEST keys (sk_test_...) until the owner confirms the live account.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook for /api/webhook/stripe (locally: `stripe listen --forward-to localhost:3000/api/webhook/stripe`).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Member logins (Kinde). Locally: make a free Kinde account, add a "Back-end web" application, and in its
# settings allow callback http://localhost:3000/api/auth/kinde_callback and logout http://localhost:3000.
# Production uses the studio's existing Kinde tenant instead, so current members keep their logins.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/account
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# The studio's existing Postgres (Supabase), shared with the old site. Locally you can point this at any
# empty Postgres and run `npx prisma db push` to create the tables. Without it the site runs in demo mode.
DATABASE_URL=
# Optional: Vercel sets this and sends it with cron requests so /api/cron/cleanup can reject strangers.
CRON_SECRET=

# Local only: opens /admin without a Kinde login while `next dev` runs (ignored in production builds).
# ADMIN_DEV_BYPASS=1
